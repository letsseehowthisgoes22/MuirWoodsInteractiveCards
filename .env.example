# Environment Variables for Business Card Scanner
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# DeepSeek API Key
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Domain configuration
DOMAIN_NAME=cards.yourdomain.com

# AWS Certificate Manager ARN for SSL/TLS
ACM_CERTIFICATE_ARN=arn:aws:acm:us-east-1:your-account:certificate/your-cert-id

# AWS Region (optional - defaults to ap-southeast-1)
AWS_REGION=ap-southeast-1
